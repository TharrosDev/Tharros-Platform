      "refersTo": "card",
      "description": "Quiet white content grouping; no default drop shadow.",
      "html": "<article class=\"ds-card\"><header class=\"ds-card-head\">Your workspace</header><p class=\"ds-card-body\">Keep the next step clear for your team.</p></article>",
      "css": ".ds-card{background:var(--card);color:var(--card-foreground);border:1px solid var(--border);border-radius:1rem;font-family:var(--font-archivo),sans-serif}.ds-card-head{padding:1rem 1.25rem;border-bottom:1px solid var(--border);font-size:1.125rem;font-weight:600}.ds-card-body{padding:1.25rem;margin:0;color:var(--muted-foreground);font-size:0.9375rem;line-height:1.6}"
    },
