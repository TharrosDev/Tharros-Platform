  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Shared primary action variant.",
      "html": "<button class=\"ds-button-primary\">Review changes</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:0.5rem;cursor:pointer;background:var(--primary);color:var(--primary-foreground);border:1px solid var(--primary-edge);border-radius:0.75rem;height:var(--control-h);padding:0 1rem;font-family:var(--font-archivo),sans-serif;font-size:0.8125rem;font-weight:600;line-height:1.2;letter-spacing:0.005em;transition:background var(--dur-state) var(--ease-out)}.ds-button-primary:hover{background:color-mix(in oklch,var(--primary) 85%,transparent)}.ds-button-primary:focus-visible{outline:2px solid var(--ring);outline-offset:2px}.ds-button-primary:active{transform:translateY(1px)}.ds-button-primary:disabled{opacity:0.45;pointer-events:none}"
    },
