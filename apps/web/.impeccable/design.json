      "css": ".ds-nav-link{display:inline-flex;align-items:center;min-height:2.75rem;padding:0.5rem 0.75rem;border-radius:0.65rem;color:var(--muted-foreground);font:650 0.875rem var(--font-archivo),sans-serif;text-decoration:none}.ds-nav-link:hover{color:var(--primary);background:var(--primary-soft)}.ds-nav-link:focus-visible{outline:2px solid var(--ring);outline-offset:2px}"
