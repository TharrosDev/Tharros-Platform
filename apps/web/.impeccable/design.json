      "html": "<label class=\"ds-field-label\" for=\"ds-name\">Organization name</label><input class=\"ds-input\" id=\"ds-name\" placeholder=\"Your organization\">",
      "css": ".ds-field-label{display:block;margin-bottom:0.5rem;font-family:var(--font-archivo),sans-serif;color:var(--foreground)}.ds-input{width:100%;height:var(--control-h);padding:0.5rem 0.75rem;border:1px solid var(--input);border-radius:0.75rem;background:var(--card);color:var(--foreground);font:500 0.875rem/1.4 var(--font-archivo),sans-serif;transition:border-color var(--dur-state)}.ds-input::placeholder{color:var(--muted-foreground)}.ds-input:hover{border-color:color-mix(in oklch,var(--foreground) 45%,transparent)}.ds-input:focus-visible{outline:2px solid var(--ring);outline-offset:2px}.ds-input[aria-invalid=\"true\"]{border:2px solid var(--destructive)}.ds-input:disabled{opacity:0.45;cursor:not-allowed}"
    },
