# Tharros Platform — environment variables
# Copy to .env.local for development. Never commit real values.
# Production/Preview values belong in the Vercel project environment.

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# AI providers
# Anthropic: assistant generation
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# OpenAI: document embeddings
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
# DeepSeek: scheduling parsing/judging
DEEPSEEK_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional direct Price IDs; lookup keys are the fallback.
STRIPE_PRICE_STARTER=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_GROWTH=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxxxxxxxxxx

# Transactional email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=Tharros <noreply@tharros.ca>

# Durable jobs worker
CRON_SECRET=replace-with-a-long-random-secret

# Observability (optional)
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxx@oXXXXXXX.ingest.us.sentry.io/XXXXXXX
# SENTRY_AUTH_TOKEN=sntrys_xxxxxxxx
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=tharros-platform
