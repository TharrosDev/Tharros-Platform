# Tharros Platform — environment variables (apps/web)
#
# Copy to `.env.local` and fill with real values for local dev. NEVER commit real
# values — `.env*` is gitignored. The authoritative store is Vercel project env
# (Production / Preview / Development); see ../docs/SECRETS.md for where each key
# comes from and how to rotate it.
#
# NEXT_PUBLIC_* are exposed to the browser bundle. Everything else is server-only.

# ── Site origin ──────────────────────────────────────────────────────────────
# Canonical public URL, used to build absolute email-redirect links (signup +
# password reset). Prod = https://tharros.ca. Optional locally — when unset the
# app falls back to VERCEL_URL, then http://localhost:3000. See lib/site-url.ts.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project `tharros-platform` (ref inxhrijqyxvwoeqczbrl, ca-central-1)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Server-only. Bypasses Row-Level Security — never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Anthropic ────────────────────────────────────────────────────────────────
# Server-only. Powers RAG / agent pipelines (from Day 26).
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ── Stripe (test mode) ───────────────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Subscription Price IDs (Day 16). Created in test mode by
# `node scripts/stripe/setup-products.mjs` — paste the IDs it prints here.
STRIPE_PRICE_STARTER=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_GROWTH=price_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxxxxxxxxxx
# Webhook signing secret (Day 18). Local: `stripe listen --forward-to \
# localhost:3000/api/webhooks/stripe` prints a whsec_ — paste it here. Deploy:
# create the endpoint in the Stripe Dashboard and vault its secret per environment.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Email (Resend — Day 13) ──────────────────────────────────────────────────
# Server-only, send-only API key. Powers the app mailer seam (lib/email) and is
# also set as the SMTP password for Supabase Auth's custom SMTP (at Supabase, not
# here). From dashboard → API Keys (scope: Sending access only).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Default From identity for app-sent mail. Optional — defaults to the canonical
# "Tharros <noreply@tharros.ca>" when unset.
# EMAIL_FROM=Tharros <noreply@tharros.ca>

# ── Deferred services (not used until later phases — leave unset) ─────────────
# Nango (OAuth connector layer) — Day 35
# NANGO_SECRET_KEY=
# NEXT_PUBLIC_NANGO_PUBLIC_KEY=
# n8n (workflow engine REST API) — Day 41
# N8N_BASE_URL=
# N8N_API_KEY=

# ── Sentry (observability — Day 7) ───────────────────────────────────────────
# DSN is browser-safe by design. When unset, Sentry init no-ops (no cost).
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxx@oXXXXXXX.ingest.us.sentry.io/XXXXXXX
# Build-time source-map upload — optional, set at launch for readable traces.
# SENTRY_AUTH_TOKEN=sntrys_xxxxxxxx
# SENTRY_ORG=your-org-slug
# SENTRY_PROJECT=tharros-platform
